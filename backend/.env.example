PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local MongoDB Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vantrack_lk?retryWrites=true&w=majority
# Or for local development:
# MONGODB_URI=mongodb://127.0.0.1:27017/vantrack_lk

# JWT Secret & Expiry
JWT_SECRET=vantrack_lk_super_secure_jwt_secret_key_2026
JWT_EXPIRE=30d

# Cloudinary (Optional, for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Cloud Messaging (Optional, for push notifications)
FIREBASE_SERVER_KEY=

# PayHere Sri Lanka (Optional, for online payments)
PAYHERE_MERCHANT_ID=
PAYHERE_SECRET=
PAYHERE_CURRENCY=LKR
